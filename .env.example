# Copia este archivo a .env y rellena tu clave real
ANTHROPIC_API_KEY=sk-ant-tu-clave-aqui
CLAUDE_MODEL=claude-sonnet-5
PORT=3000

# Integracion con WhatsApp (Meta Cloud API) - opcional, solo si quieres
# conectar el bot a un numero de WhatsApp real
WHATSAPP_VERIFY_TOKEN=elige-una-palabra-secreta-cualquiera
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# Resend (email por API, no SMTP) para avisar cuando entra una reserva nueva.
# Es nuestra cuenta de infraestructura, no la del cliente: cada negocio solo
# indica su email de aviso en config/business.json (campo email_notificaciones).
# Crea una cuenta gratis en resend.com y saca la clave en API Keys.
RESEND_API_KEY=
# En modo sandbox (sin dominio propio verificado en Resend) solo se puede
# enviar a la direccion con la que te registraste en Resend. Deja este valor
# por defecto hasta verificar un dominio propio.
EMAIL_FROM=onboarding@resend.dev

# Palabra secreta para poder abrir /admin/citas?clave=...
ADMIN_SECRET=elige-otra-palabra-secreta

# En Railway: ruta del volumen persistente donde se guardan las reservas, para
# que no se borren en cada redeploy. En local puedes dejarla vacia.
DATA_DIR=
